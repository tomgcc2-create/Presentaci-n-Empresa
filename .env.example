# ══════════════════════════════════════════════════════════════
#  PriceNice — Variables de entorno / configuración
#  Copia este archivo a .env y rellena los valores reales.
#  Las variables marcadas con [WORKER] se configuran en
#  Cloudflare → Workers → Settings → Variables and Secrets,
#  NO en este archivo (nunca metas secretos en .env del repo).
# ══════════════════════════════════════════════════════════════

# ── Google Maps ────────────────────────────────────────────
# Obtén tu clave en: https://console.cloud.google.com/google/maps-apis/credentials
# Habilita: Maps JavaScript API, Places API y Geocoding API (opcional)
GOOGLE_MAPS_API_KEY=tu_clave_de_google_maps_aqui

# ── Cloudflare Worker — Chatbot (Gemini) ───────────────────
# [WORKER] GEMINI_API_KEY=          secreto — clave de Google AI Studio
# [WORKER] GEMINI_MODEL=gemini-2.0-flash    — modelo a usar (opcional)
# [WORKER] ALLOWED_ORIGINS=https://tusitio.com   — orígenes CORS permitidos

# ── Cloudflare Worker — Modo prueba admin ──────────────────
# [WORKER] ADMIN_TEST_MODE=true     — "true" activa el modo; "false" lo desactiva en producción
# [WORKER] ADMIN_TEST_CODE=         secreto — código que escribe el admin en el campo correo
# [WORKER] ADMIN_SALT=              secreto — cadena aleatoria larga para firmar tokens HMAC

# ── Cloudflare Worker — Asistente IA del vendedor ─────────
# [WORKER] IA_VENDEDOR_DAILY_LIMIT=20
#           Número máximo de consultas que cada vendedor puede hacer por día.
#           Si no se define, el Worker usa 20 como valor por defecto.
#           Auméntalo si los vendedores necesitan más, o bájalo para controlar costos.
#
# [WORKER] RATE_LIMIT_KV             (binding KV)
#           Namespace de Cloudflare KV enlazado al Worker con el nombre RATE_LIMIT_KV.
#           Se usa para rate-limiting del modo prueba admin Y del asistente IA del vendedor.
#           Créalo en Cloudflare → Workers → KV y vincula el binding al Worker.
